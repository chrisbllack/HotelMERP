[Unit]
Description=INFINEON Enterprise Platform
Documentation=https://github.com/chrisbllack/HotelMERP/blob/main/docs/DEPLOYMENT.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=infineon
Group=infineon
WorkingDirectory=/var/lib/infineon
EnvironmentFile=-/etc/infineon/infineon.env
Environment=INFINEON_BIND_ADDRESS=127.0.0.1
ExecStart=/usr/local/bin/infineon serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/infineon
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=infineon

[Install]
WantedBy=multi-user.target
